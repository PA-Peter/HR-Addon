  "html": "<style type=\"text/css\">\n    @page {\n        size: A4 portrait;\n        margin: 6mm;\n    }\n\n    body {\n        margin: 0;\n        color: #20252b;\n        font-family: Arial, sans-serif;\n        font-size: 8pt;\n        line-height: 1.2;\n    }\n\n    h1 {\n        margin: 0 0 1.5mm;\n        text-align: center;\n        font-size: 14pt;\n        page-break-after: avoid;\n    }\n\n    h2 {\n        margin: 1.5mm 0 0.8mm;\n        font-size: 10pt;\n        page-break-after: avoid;\n        break-after: avoid-page;\n    }\n\n    .report-meta {\n        margin: 0 0 1mm;\n        padding: 1mm 2mm;\n        background: #f3f5f7;\n        font-size: 8pt;\n    }\n\n    .report-section {\n        margin: 0;\n        page-break-inside: avoid;\n        break-inside: avoid-page;\n    }\n\n    .report-table {\n        display: inline-table !important;\n        width: auto !important;\n        max-width: 100% !important;\n        margin: 0;\n        border-collapse: collapse;\n        table-layout: auto !important;\n        font-size: 7.5pt;\n    }\n\n    .report-table thead {\n        display: table-header-group;\n    }\n\n    .report-table th {\n        padding: 0.8mm 1.2mm;\n        border-bottom: 1px solid #87919b;\n        background: #edf0f3;\n        text-align: left;\n        vertical-align: bottom;\n        white-space: normal;\n    }\n\n    .report-table td {\n        padding: 0.7mm 1.2mm;\n        border-bottom: 1px solid #d9dee3;\n        overflow-wrap: anywhere;\n        vertical-align: top;\n    }\n\n    .report-table tr {\n        page-break-inside: avoid;\n    }\n\n    .report-table .number {\n        text-align: right;\n        white-space: nowrap;\n        font-variant-numeric: tabular-nums;\n    }\n\n    .report-table .total-row td {\n        border-top: 1px solid #87919b;\n        background: #f3f5f7;\n        font-weight: bold;\n    }\n\n    .period { width: 20mm !important; }\n    .employee-id { width: 28mm !important; }\n    .employee-name { width: 42mm !important; }\n    .metric { width: 21mm !important; }\n\n    .printed-on {\n        margin-top: 2mm;\n        color: #68727d;\n        font-size: 7pt;\n        text-align: right;\n    }\n\n    img, .letter-head img, header img {\n        max-width: 100% !important;\n        max-height: 20mm !important;\n        width: auto !important;\n        height: auto !important;\n        object-fit: contain;\n    }\n\n    .letter-head {\n        height: auto !important;\n        min-height: 0 !important;\n        max-height: 24mm !important;\n        overflow: hidden !important;\n        margin-bottom: 2mm !important;\n    }\n</style>\n\n<div>\n    <h1>{%= title %}</h1>\n\n    <div class=\"report-meta\">\n        <strong>{%= __(\"Zeitraum\") %}:</strong>\n        {%= frappe.datetime.str_to_user(filters.from_date) %}\n        – {%= frappe.datetime.str_to_user(filters.to_date) %}\n        &nbsp;&nbsp;\n        <strong>{%= __(\"Gruppierung\") %}:</strong>\n        {%= filters.aggregation || __(\"Monat\") %}\n    </div>\n\n    <div class=\"report-section\">\n    <h2>{%= __(\"Kapazität und Ausfall\") %}</h2>\n    <table class=\"report-table\">\n        <thead>\n            <tr>\n                <th class=\"period\">{%= __(\"Zeitraum\") %}</th>\n                <th class=\"employee-id\">{%= __(\"Mitarbeiter-ID\") %}</th>\n                <th class=\"employee-name\">{%= __(\"Mitarbeiter\") %}</th>\n                <th class=\"metric number\">{%= __(\"Soll [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Verfügbar [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Ausfall [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Verfügbar [%]\") %}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for (var i = 0; i < data.length; i++) { %}\n                {% var row = data[i]; %}\n                <tr class=\"{% if (!row.employee) { %}total-row{% } %}\">\n                    <td>{%= row.periode || \"\" %}</td>\n                    <td>{%= row.employee || \"\" %}</td>\n                    <td>{%= row.mitarbeiter || \"\" %}</td>\n                    <td class=\"number\">{%= frappe.format(row.soll_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.verfuegbar_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.auswahl_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.verfuegbar_pct, {fieldtype: \"Float\", precision: 2}) %}</td>\n                </tr>\n            {% } %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"report-section\">\n    <h2>{%= __(\"Abwesenheitsstunden\") %}</h2>\n    <table class=\"report-table\">\n        <thead>\n            <tr>\n                <th class=\"period\">{%= __(\"Zeitraum\") %}</th>\n                <th class=\"employee-id\">{%= __(\"Mitarbeiter-ID\") %}</th>\n                <th class=\"employee-name\">{%= __(\"Mitarbeiter\") %}</th>\n                <th class=\"metric number\">{%= __(\"Krankheit [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Urlaub [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Unbezahlt [h]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Sonstige [h]\") %}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for (var i = 0; i < data.length; i++) { %}\n                {% var row = data[i]; %}\n                <tr class=\"{% if (!row.employee) { %}total-row{% } %}\">\n                    <td>{%= row.periode || \"\" %}</td>\n                    <td>{%= row.employee || \"\" %}</td>\n                    <td>{%= row.mitarbeiter || \"\" %}</td>\n                    <td class=\"number\">{%= frappe.format(row.krank_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.urlaub_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.unbezahlt_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.sonstige_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                </tr>\n            {% } %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"report-section\">\n    <h2>{%= __(\"Quoten und Ausfall\") %}</h2>\n    <table class=\"report-table\">\n        <thead>\n            <tr>\n                <th class=\"period\">{%= __(\"Zeitraum\") %}</th>\n                <th class=\"employee-id\">{%= __(\"Mitarbeiter-ID\") %}</th>\n                <th class=\"employee-name\">{%= __(\"Mitarbeiter\") %}</th>\n                <th class=\"metric number\">{%= __(\"Krankheit [%]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Urlaub [%]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Ausfall gesamt [%]\") %}</th>\n                <th class=\"metric number\">{%= __(\"Ausfall [h]\") %}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for (var i = 0; i < data.length; i++) { %}\n                {% var row = data[i]; %}\n                <tr class=\"{% if (!row.employee) { %}total-row{% } %}\">\n                    <td>{%= row.periode || \"\" %}</td>\n                    <td>{%= row.employee || \"\" %}</td>\n                    <td>{%= row.mitarbeiter || \"\" %}</td>\n                    <td class=\"number\">{%= frappe.format(row.krank_pct, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.urlaub_pct, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.ausfall_pct, {fieldtype: \"Float\", precision: 2}) %}</td>\n                    <td class=\"number\">{%= frappe.format(row.auswahl_h, {fieldtype: \"Float\", precision: 2}) %}</td>\n                </tr>\n            {% } %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"printed-on\">\n        {%= __(\"Erstellt am\") %}:\n        {%= frappe.datetime.str_to_user(frappe.datetime.get_datetime_as_string()) %}\n    </div>\n</div>\n",
